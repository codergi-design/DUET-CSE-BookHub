<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <!-- Top Blue Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#0284C7"
        android:paddingBottom="15dp"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Post a Book for Sale"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/topBar"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill Book Details"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Book Title -->
            <EditText
                android:id="@+id/titleEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Book Title (e.g. Data Structure)"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="14dp"
                android:textSize="15sp" />

            <!-- Author Name -->
            <EditText
                android:id="@+id/authorEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Author Name"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Price -->
            <EditText
                android:id="@+id/priceEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Price (e.g. 350)"
                android:inputType="number"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Semester -->
            <EditText
                android:id="@+id/semesterEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Semester (e.g. 1st, 2nd, 3rd, 4th)"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Condition -->
            <EditText
                android:id="@+id/conditionEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Condition (e.g. Used - Good, Like New)"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Phone Number Input -->
            <EditText
                android:id="@+id/phoneEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Seller Phone (e.g. 01700000000)"
                android:inputType="phone"
                android:background="@drawable/premium_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="24dp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/postBookBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="POST BOOK"
                android:backgroundTint="#0284C7"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="25dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyBooks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Books"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAddBook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="#0284C7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Book"
                android:textColor="#0284C7"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>